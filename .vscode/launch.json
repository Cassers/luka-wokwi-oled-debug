{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OLED — depuración REMOTA GHI (no Python del PC)",
            "preLaunchTask": "Wokwi GHI: comprobar puente activo",
            "type": "micropython",
            "request": "launch",
            "program": "${workspaceFolder}/MicroPython-debug/oled_demo.py",
            "sync": true,
            "stopOnEntry": true,
            "debugInterface": "uart",
            "debugPort": "${workspaceFolder}/.tools/wokwi-ghi-uart",
            "debugBaud": 115200,
            "checkFirmwareUpdate": false
        },
